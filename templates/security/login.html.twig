{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center pb-12 px-4 sm:px-6 lg:px-8">
    {% include "security/login-dialog.html.twig" %}
</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script type="module">
        import useLoginForm from '{{ asset('js/login.js') }}';

        const loginForm = useLoginForm();
        loginForm.login('/api');
    </script>
{% endblock %}
