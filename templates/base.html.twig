<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SecureZ{% endblock %}</title>
    {% block stylesheets %}
        {{ vite_entry_link_tags('app') }}
    {% endblock %}
</head>
<body class="h-full">
<div class="min-h-full">
    {# Navigation #}
    <nav class="bg-gradient-to-r from-primary to-secondary">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex h-16 items-center justify-between">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <a href="{{ path('app_home') }}" class="text-white font-bold text-xl">SecureZ</a>
                    </div>
                    <div class="hidden md:block">
                        <div class="ml-10 flex items-baseline space-x-4">
                            {% block navigation %}
                                <a href="{{ path('app_home') }}" class="text-white hover:bg-white/10 rounded-md px-3 py-2 text-sm font-medium">Home</a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="/api/doc" class="text-white/80 hover:text-white hover:bg-white/10 rounded-md px-3 py-2 text-sm font-medium">API Docs</a>
                                {% endif %}
                            {% endblock %}
                        </div>
                    </div>
                </div>
                <div class="hidden md:block">
                    <div class="ml-4 flex items-center md:ml-6">
                        {% if app.user %}
                            <div class="text-white px-3 py-2 text-sm">
                                {{ app.user.email }}
                            </div>
                            <a href="{{ path('app_logout') }}"
                               class="ml-3 inline-flex items-center rounded-md bg-white/10 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-white/20">
                                Logout
                            </a>
                        {% else %}
                            <a href="{{ path('app_login') }}"
                               class="ml-3 inline-flex items-center rounded-md bg-white/10 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-white/20">
                                Login
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </nav>

    {# Header #}
    {% block header %}
        <header class="bg-white shadow">
            <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
                <h1 class="text-3xl font-bold tracking-tight text-gray-900">
                    {% block header_title %}{% endblock %}
                </h1>
            </div>
        </header>
    {% endblock %}

    {# Main content #}
    <main>
        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-4">
                    <div class="rounded-md p-4 {% if label == 'success' %}bg-green-50 text-green-700 border border-green-200{% else %}bg-red-50 text-red-700 border border-red-200{% endif %}">
                        {{ message }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
            {% block body %}{% endblock %}
        </div>
    </main>
</div>

{% block javascripts %}
            {{ vite_entry_script_tags('app') }}
{% endblock %}
</body>
</html>
